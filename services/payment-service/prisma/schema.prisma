generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Payment {
  id                  Int       @id @default(autoincrement())
  tripId              Int       @unique @map("trip_id")
  customerId          Int       @map("customer_id")
  amount              Decimal   @db.Decimal(12, 2)
  paymentMethod       String    @map("payment_method") @db.VarChar(30)
  status              String    @default("PENDING") @db.VarChar(20)
  transactionId       String?   @unique @map("transaction_id") @db.VarChar(100)
  idempotencyKey      String?   @unique @map("idempotency_key") @db.VarChar(100)
  paidAt              DateTime? @map("paid_at")
  failedAt            DateTime? @map("failed_at")
  failureReason       String?   @map("failure_reason") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("payment")
}