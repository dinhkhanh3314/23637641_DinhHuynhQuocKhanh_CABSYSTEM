openapi: 3.0.3
info:
  title: CABSystem API
  version: 1.0.0
  description: 'API đặt xe trực tuyến của công ty ABC (CABSystem).

    Vai trò (x-roles): CUSTOMER, DRIVER, ADMIN.


    Kiến trúc: Client -> API Gateway (REST/HTTPS, điểm vào duy nhất) -> Microservice (gRPC). Mỗi operation có x-service cho biết service xử lý.

    Gateway xác thực JWT cục bộ; Auth Service chỉ xử lý đăng ký, đăng nhập và refresh token.

    Các service trao đổi sự kiện qua Kafka nên một số kết quả xuất hiện bất đồng bộ (Trip sau khi Driver chấp nhận, Payment sau khi Trip hoàn thành).

    Không tích hợp Payment Provider và Notification Provider bên ngoài: thanh toán điện tử do Payment Service xử lý nội bộ (mô phỏng), thông báo là thông báo trong hệ thống.


    Trạng thái Booking: PENDING_DRIVER -> SENT_TO_DRIVER -> ACCEPTED; CANCELLED; NO_DRIVER_FOUND (giả định, cần stakeholder xác nhận).

    Trạng thái Trip: CREATED -> IN_PROGRESS -> COMPLETED.

    Trạng thái Payment: PENDING -> PROCESSING -> SUCCESS | FAILED.

    '
servers:
- url: https://api.abc.com/api/v1
security:
- bearerAuth: []
tags:
- name: Auth
  description: FR-01..03 (Auth Service; /users/me do Customer Service hoặc Driver Service theo vai trò)
- name: Booking
  description: FR-04..07 (Booking Service)
- name: DriverMatching
  description: 'FR-08..12 (Booking Service: offer; Driver Service: trạng thái Driver)'
- name: Trip
  description: FR-13..17 (Trip Service)
- name: Vehicle
  description: FR-18..19 (Driver Service)
- name: Payment
  description: FR-20..23 (Payment Service)
- name: Rating
  description: FR-24..25 (Trip Service)
- name: Admin
  description: FR-26..28 (Customer, Driver, Booking, Trip Service theo tài nguyên)
- name: Notification
  description: FR-29 (Notification Service)
paths:
  /auth/register:
    post:
      tags:
      - Auth
      summary: Đăng ký tài khoản Customer
      description: 'FR-01, UC-01, BRL-01. Roles: public'
      operationId: register
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
      responses:
        '201':
          description: Tạo tài khoản thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '400':
          $ref: '#/components/responses/BadRequest'
        '409':
          description: Tài khoản đã tồn tại (ACCOUNT_ALREADY_EXISTS)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      x-service: Auth Service
  /auth/login:
    post:
      tags:
      - Auth
      summary: Đăng nhập
      description: 'FR-02, UC-02, BRL-02. Roles: public (Customer, Driver, Admin)'
      operationId: login
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
      responses:
        '200':
          description: Đăng nhập thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthToken'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          description: Tài khoản không được phép truy cập (ACCOUNT_LOCKED)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      x-service: Auth Service
  /users/me:
    get:
      tags:
      - Auth
      summary: Xem thông tin cá nhân
      description: 'FR-03, UC-03. Roles: CUSTOMER, DRIVER. Gateway định tuyến theo vai trò: CUSTOMER -> Customer Service, DRIVER -> Driver Service'
      operationId: getMe
      x-roles:
      - CUSTOMER
      - DRIVER
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '401':
          $ref: '#/components/responses/Unauthorized'
      x-service: Customer Service (CUSTOMER) / Driver Service (DRIVER)
    put:
      tags:
      - Auth
      summary: Cập nhật thông tin cá nhân
      description: 'FR-03, UC-03. Roles: CUSTOMER, DRIVER. Gateway định tuyến theo vai trò: CUSTOMER -> Customer Service, DRIVER -> Driver Service'
      operationId: updateMe
      x-roles:
      - CUSTOMER
      - DRIVER
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UserUpdate'
      responses:
        '200':
          description: Cập nhật thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '409':
          $ref: '#/components/responses/Conflict'
      x-service: Customer Service (CUSTOMER) / Driver Service (DRIVER)
  /bookings:
    post:
      tags:
      - Booking
      summary: Tạo Booking
      description: 'FR-04, UC-04, BRL-04, BRL-25. Roles: CUSTOMER. Booking Service tính estimatedFare, sau đó tự động tìm Driver (UC-08, xử lý nội bộ). Booking ở trạng thái PENDING_DRIVER.'
      operationId: createBooking
      x-roles:
      - CUSTOMER
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BookingCreate'
      responses:
        '201':
          description: Booking được tạo
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Booking'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
      x-service: Booking Service
    get:
      tags:
      - Booking
      summary: Xem lịch sử Booking
      description: 'FR-07, UC-07. Roles: CUSTOMER'
      operationId: listMyBookings
      x-roles:
      - CUSTOMER
      parameters:
      - $ref: '#/components/parameters/Page'
      - $ref: '#/components/parameters/Size'
      - name: status
        in: query
        schema:
          $ref: '#/components/schemas/BookingStatus'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BookingList'
        '401':
          $ref: '#/components/responses/Unauthorized'
      x-service: Booking Service
  /bookings/{bookingId}:
    get:
      tags:
      - Booking
      summary: Xem trạng thái Booking
      description: 'FR-05, UC-05. Roles: CUSTOMER (chủ sở hữu)'
      operationId: getBooking
      x-roles:
      - CUSTOMER
      parameters:
      - $ref: '#/components/parameters/BookingId'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Booking'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
      x-service: Booking Service
  /bookings/{bookingId}/cancel:
    post:
      tags:
      - Booking
      summary: Hủy Booking
      description: 'FR-06, UC-06, BRL-05. Roles: CUSTOMER. Chỉ hủy được khi Booking ở trạng thái cho phép (PENDING_DRIVER, SENT_TO_DRIVER).'
      operationId: cancelBooking
      x-roles:
      - CUSTOMER
      parameters:
      - $ref: '#/components/parameters/BookingId'
      responses:
        '200':
          description: Hủy thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Booking'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: BOOKING_NOT_CANCELLABLE
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      x-service: Booking Service
  /drivers/me/status:
    put:
      tags:
      - DriverMatching
      summary: Cập nhật trạng thái hoạt động và vị trí Driver
      description: 'Phục vụ FR-08 (BRL-07, BRL-11). Roles: DRIVER'
      operationId: updateDriverStatus
      x-roles:
      - DRIVER
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DriverStatusUpdate'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Driver'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
      x-service: Driver Service
  /drivers/me/booking-offers:
    get:
      tags:
      - DriverMatching
      summary: Xem Booking được gửi đến Driver
      description: 'FR-09, UC-08/UC-09. Roles: DRIVER. Matching (UC-08, UC-10) là xử lý nội bộ của Booking Service; Driver nhận offer qua danh sách này hoặc thông báo BOOKING_OFFER_CREATED. Offer hết hạn (expiresAt) chuyển EXPIRED (BRL-10, BRL-27).'
      operationId: listMyOffers
      x-roles:
      - DRIVER
      parameters:
      - name: status
        in: query
        schema:
          $ref: '#/components/schemas/OfferStatus'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/BookingOffer'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
      x-service: Booking Service
  /booking-offers/{offerId}/accept:
    post:
      tags:
      - DriverMatching
      summary: Driver chấp nhận Booking
      description: 'FR-10, FR-13, UC-09, BRL-09, BRL-14, BRL-29. Roles: DRIVER. Booking Service kiểm tra trạng thái kèm optimistic lock, chuyển Booking sang ACCEPTED và phát BookingAccepted; Trip Service tạo Trip bất đồng bộ nên response chưa chứa Trip. Customer lấy tripId qua GET /bookings/{bookingId} (có thể null trong thời gian ngắn). Driver lấy Trip qua GET /trips?status=CREATED. Cả hai đều nhận thông báo TRIP_CREATED.'
      operationId: acceptOffer
      x-roles:
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/OfferId'
      responses:
        '200':
          description: Đã chấp nhận. Trip sẽ được tạo bất đồng bộ
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AcceptOfferResponse'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: OFFER_EXPIRED / OFFER_ALREADY_RESPONDED / Booking đã hủy
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      x-service: Booking Service
  /booking-offers/{offerId}/reject:
    post:
      tags:
      - DriverMatching
      summary: Driver từ chối Booking
      description: 'FR-10, FR-11, UC-09, UC-10, BRL-06, BRL-13. Roles: DRIVER. Hệ thống tự động tìm Driver thay thế, không gửi lại cho Driver đã từ chối. Nếu hết Driver, Booking chuyển NO_DRIVER_FOUND và Customer được thông báo (FR-12, BRL-12).'
      operationId: rejectOffer
      x-roles:
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/OfferId'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RejectRequest'
      responses:
        '204':
          description: Đã từ chối
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          $ref: '#/components/responses/Conflict'
      x-service: Booking Service
  /trips:
    get:
      tags:
      - Trip
      summary: Xem lịch sử Trip
      description: 'FR-17, UC-14. Roles: CUSTOMER (Trip của mình), DRIVER (Trip được phân công)'
      operationId: listMyTrips
      x-roles:
      - CUSTOMER
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/Page'
      - $ref: '#/components/parameters/Size'
      - name: status
        in: query
        schema:
          $ref: '#/components/schemas/TripStatus'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TripList'
        '401':
          $ref: '#/components/responses/Unauthorized'
      x-service: Trip Service
  /trips/{tripId}:
    get:
      tags:
      - Trip
      summary: Theo dõi Trip
      description: 'FR-15, UC-11. Roles: CUSTOMER, DRIVER (liên quan đến Trip)'
      operationId: getTrip
      x-roles:
      - CUSTOMER
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Trip'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
      x-service: Trip Service
  /trips/{tripId}/status:
    patch:
      tags:
      - Trip
      summary: Cập nhật trạng thái Trip
      description: 'FR-14, UC-12, BRL-15. Roles: DRIVER. Chỉ cho phép CREATED -> IN_PROGRESS. Hoàn thành dùng endpoint /complete.'
      operationId: updateTripStatus
      x-roles:
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/TripId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TripStatusUpdate'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Trip'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: TRIP_INVALID_TRANSITION
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      x-service: Trip Service
  /trips/{tripId}/complete:
    post:
      tags:
      - Trip
      summary: Hoàn thành Trip
      description: 'FR-16, FR-20, UC-13, BRL-16. Roles: DRIVER. Chỉ khi Trip đang IN_PROGRESS. Trip Service phát TripCompleted; Payment Service tạo Payment (PENDING) bất đồng bộ nên paymentId trong response có thể null.'
      operationId: completeTrip
      x-roles:
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Trip hoàn thành
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Trip'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: TRIP_NOT_IN_PROGRESS
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      x-service: Trip Service
  /drivers/me/vehicles:
    get:
      tags:
      - Vehicle
      summary: Xem danh sách Vehicle của Driver
      description: 'FR-18, UC-15. Roles: DRIVER'
      operationId: listMyVehicles
      x-roles:
      - DRIVER
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Vehicle'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
      x-service: Driver Service
    post:
      tags:
      - Vehicle
      summary: Thêm Vehicle
      description: 'FR-18, UC-15. Roles: DRIVER'
      operationId: createMyVehicle
      x-roles:
      - DRIVER
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VehicleInput'
      responses:
        '201':
          description: Đã tạo
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Vehicle'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '409':
          $ref: '#/components/responses/Conflict'
      x-service: Driver Service
  /drivers/me/vehicles/{vehicleId}:
    put:
      tags:
      - Vehicle
      summary: Cập nhật Vehicle
      description: 'FR-18, UC-15. Roles: DRIVER (chủ sở hữu)'
      operationId: updateMyVehicle
      x-roles:
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/VehicleId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VehicleInput'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Vehicle'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
      x-service: Driver Service
    delete:
      tags:
      - Vehicle
      summary: Xóa (vô hiệu hóa) Vehicle
      description: 'FR-18, UC-15. Roles: DRIVER (chủ sở hữu)'
      operationId: deleteMyVehicle
      x-roles:
      - DRIVER
      parameters:
      - $ref: '#/components/parameters/VehicleId'
      responses:
        '204':
          description: Đã xóa
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
      x-service: Driver Service
  /trips/{tripId}/payment:
    get:
      tags:
      - Payment
      summary: Xem Payment của Trip
      description: 'FR-20, FR-23, UC-18. Roles: CUSTOMER. Payment được tạo bất đồng bộ sau TripCompleted; nếu chưa có trả 404 và client thử lại sau.'
      operationId: getTripPayment
      x-roles:
      - CUSTOMER
      parameters:
      - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
      x-service: Payment Service
  /payments/{paymentId}:
    get:
      tags:
      - Payment
      summary: Xem kết quả Payment
      description: 'FR-23, UC-18. Roles: CUSTOMER'
      operationId: getPayment
      x-roles:
      - CUSTOMER
      parameters:
      - $ref: '#/components/parameters/PaymentId'
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
      x-service: Payment Service
  /payments/{paymentId}/pay:
    post:
      tags:
      - Payment
      summary: Thực hiện thanh toán
      description: 'FR-21, UC-17, BRL-17, BRL-18, BRL-19, BRL-20. Roles: CUSTOMER. CASH: ghi nhận hình thức thanh toán. ONLINE: Payment Service xử lý giao dịch nội bộ (mô phỏng) và cập nhật status của Payment (SUCCESS hoặc FAILED). Không lưu thông tin thẻ. Thất bại có thể gọi lại theo chính sách và không đổi trạng thái Trip (NFR-13).'
      operationId: payTrip
      x-roles:
      - CUSTOMER
      parameters:
      - $ref: '#/components/parameters/PaymentId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PayRequest'
      responses:
        '200':
          description: Đã ghi nhận. Kiểm tra payment.status
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PayResponse'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: TRIP_NOT_COMPLETED / PAYMENT_ALREADY_SUCCESS
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      x-service: Payment Service
  /trips/{tripId}/rating:
    post:
      tags:
      - Rating
      summary: Đánh giá Driver
      description: 'FR-24, UC-19, BRL-21, BRL-22. Roles: CUSTOMER. Chỉ khi Trip COMPLETED và chưa có Rating.'
      operationId: createRating
      x-roles:
      - CUSTOMER
      parameters:
      - $ref: '#/components/parameters/TripId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RatingCreate'
      responses:
        '201':
          description: Đã lưu
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Rating'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: TRIP_NOT_COMPLETED / RATING_ALREADY_EXISTS
          content:
            application/json:
              schema:
