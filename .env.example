# PostgreSQL
POSTGRES_USER=<postgres_username>
POSTGRES_PASSWORD=<postgres_password>

# MongoDB
MONGO_ROOT_USERNAME=<mongodb_username>
MONGO_ROOT_PASSWORD=<mongodb_password>

# Redis
REDIS_PORT=<redis_port>

# Kafka
KAFKA_PORT=<kafka_port>
KAFKA_BROKERS=<kafka_host>:<kafka_port>

# Mock Payment Provider
PAYMENT_PROVIDER_PORT=<mock_payment_provider_port>

# Auth
JWT_SECRET=<jwt_secret>
NODE_ENV=development

# API Gateway health check targets
AUTH_SERVICE_URL=http://localhost:3001
CUSTOMER_SERVICE_URL=http://localhost:3002
DRIVER_SERVICE_URL=http://localhost:3003
BOOKING_SERVICE_URL=http://localhost:3004
TRIP_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
HEALTH_CHECK_TIMEOUT_MS=2000